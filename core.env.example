# 新安装：仅核心，不启用可选后台调度和外部完成通知。
# 由部署维护者接到实际运行 Web/controller 的服务环境，不由网页读取。
# 修改后须按维护流程重启 Web 才生效；无需重启原生 App Server。
CODEX_WEB_AUTOMATIONS_ENABLED=0
CODEX_WEB_COMPLETION_NOTIFICATIONS_ENABLED=0

# 需要任务完成通知时，先配置自己的任务通道发送器和私有主题文件。
# 发送器协议见 INSTALL.md；不要填写或提交主题值、告警通道或他人的配置。
# CODEX_WEB_TASK_NOTIFICATION_COMMAND=/absolute/path/task-notify.sh
# CODEX_WEB_TASK_NTFY_TOPIC_FILE=/absolute/path/private-task-topic
